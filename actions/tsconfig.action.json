{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["esnext", "es2021.intl"],
    "typeRoots": ["../node_modules/@dynatrace/js-runtime/types", "../node_modules/@types"],
    "types": ["node", "runtime"]
  },
  "include": ["**/*.action.ts", "**/*.logic.ts"]
}
